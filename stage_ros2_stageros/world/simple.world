# Minimal Stage world for stage_ros2_stageros.
# It creates one differential-drive position model with one ranger.

include "simple_robot.inc"

interval_sim 100  # milliseconds per simulation update
interval_real 100
paused 0

window
(
  size [ 800 600 ]
  center [ 0 0 ]
  scale 50
)

# A few simple obstacles.
define wall model
(
  color "gray30"
  boundary 1
  gui_nose 0
  gui_grid 0
)

wall( name "north_wall" pose [ 0  4 0 0 ] size [ 8.0 0.1 1.0 ] )
wall( name "south_wall" pose [ 0 -4 0 0 ] size [ 8.0 0.1 1.0 ] )
wall( name "east_wall"  pose [ 4  0 0 0 ] size [ 0.1 8.0 1.0 ] )
wall( name "west_wall"  pose [-4  0 0 0 ] size [ 0.1 8.0 1.0 ] )
wall( name "box"        pose [ 1  1 0 0 ] size [ 0.8 0.8 1.0 ] )

ros2_robot
(
  name "robot_0"
  pose [ -2 -2 0 45 ]
)
